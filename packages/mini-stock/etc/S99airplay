#!/bin/sh
# Capsula Mini stock: entry from overlay S50avahi-daemon after overlay mount.
D=/data/local/capsula-airplay
export LD_LIBRARY_PATH="$D/bin"
running() {
  [ -f "/var/run/$1.pid" ] || return 1
  p=$(cat "/var/run/$1.pid")
  [ "$(readlink "/proc/$p/exe" 2>/dev/null)" = "$D/bin/$1" ] && kill -0 "$p" 2>/dev/null
}
start_one() {
  running "$1" && return
  if [ "$1" = capsula-ui ]; then
    nohup "$D/bin/$1" >>/tmp/capsula-ui.log 2>&1 </dev/null &
    echo $! >"/var/run/$1.pid"
  else
    start-stop-daemon -S -b -m -p "/var/run/$1.pid" -x "$D/bin/$1"
  fi
}
stop_one() {
  if running "$1"; then kill "$(cat "/var/run/$1.pid")"; fi
  rm -f "/var/run/$1.pid"
}
case "$1" in
start)
  avahi-daemon -c >/dev/null 2>&1 || avahi-daemon --no-drop-root -D
  sh "$D/init.d/nqptp" start
  sleep 1
  sh "$D/init.d/shairport-sync" start
  start_one capsula-airplay-keys
  start_one capsula-ui
  ;;
stop)
  stop_one capsula-ui
  stop_one capsula-airplay-keys
  sh "$D/init.d/shairport-sync" stop
  sh "$D/init.d/nqptp" stop
  ;;
restart) sh "$0" stop; sleep 2; sh "$0" start ;;
status)
  for name in nqptp shairport-sync capsula-airplay-keys capsula-ui; do
    if running "$name"; then echo "$name: running"; else echo "$name: stopped"; fi
  done
  ;;
*) echo "Usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
