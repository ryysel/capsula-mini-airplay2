#!/bin/sh
# nqptp for shairport-sync AirPlay 2 (VK Капсула 2019, Buildroot).
BIN=/data/local/capsula-airplay/bin/nqptp
PID=/var/run/nqptp.pid

running() {
    [ -f "$PID" ] || return 1
    pid=$(cat "$PID" 2>/dev/null) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
  start)
    [ -x "$BIN" ] || exit 0
    running && exit 0
    echo "Starting nqptp"
    start-stop-daemon -S -q -b -m -p "$PID" -x "$BIN"
    ;;
  stop)
    echo "Stopping nqptp"
    if running; then
        start-stop-daemon -K -q -p "$PID" -s TERM
    fi
    rm -f "$PID"
    ;;
  status)
    running && echo "nqptp: running" || echo "nqptp: stopped"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
