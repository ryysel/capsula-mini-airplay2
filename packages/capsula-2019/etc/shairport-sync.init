#!/bin/sh
# shairport-sync AirPlay 2 receiver (VK Капсула 2019, Buildroot).
BIN=/data/local/capsula-airplay/bin/shairport-sync
CONF=/data/local/capsula-airplay/etc/shairport-sync.conf
PID=/var/run/shairport-sync.pid
NQPID=/var/run/nqptp.pid

# pidof does not see this binary reliably on the stock busybox, so the pidfile
# is the source of truth.
running() {
    [ -f "$PID" ] || return 1
    pid=$(cat "$PID" 2>/dev/null) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

nqptp_running() {
    [ -f "$NQPID" ] || return 1
    pid=$(cat "$NQPID" 2>/dev/null) || return 1
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

case "$1" in
  start)
    [ -x "$BIN" ] || exit 0
    running && exit 0
    # nqptp creates its shared memory interface right after start.
    nqptp_running && sleep 1
    echo "Starting shairport-sync"
    start-stop-daemon -S -q -b -m -p "$PID" -x "$BIN" -- \
        --configfile="$CONF" --log-to-syslog
    ;;
  stop)
    echo "Stopping shairport-sync"
    if running; then
        start-stop-daemon -K -q -p "$PID" -s TERM
    fi
    rm -f "$PID"
    ;;
  status)
    running && echo "shairport-sync: running" || echo "shairport-sync: stopped"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
